# AgriPulse local environment (safe to commit)
# Copy to .env and customize:  cp .env.example .env
# Never commit real production secrets.

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password123
POSTGRES_DB=agripulse

# Used by the FastAPI backend (host = service name inside Compose)
DATABASE_URL=postgresql://postgres:password123@postgres:5432/agripulse

# --- MQTT ---
MQTT_HOST=mqtt-broker
MQTT_PORT=1883
MQTT_TOPIC=agripulse/telemetry/#

# --- Cold-chain thresholds ---
TEMP_MIN_C=2.0
TEMP_MAX_C=8.0
HUMIDITY_MIN_PCT=40.0
HUMIDITY_MAX_PCT=90.0
ALERT_COOLDOWN_SEC=60

# --- Simulator ---
PUBLISH_INTERVAL_SEC=5

# --- Frontend (browser-facing; use localhost when opening UI on the host) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/telemetry
